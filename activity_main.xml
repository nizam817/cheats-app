<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#1a1a2e">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 Cheat Overlay"
        android:textSize="28sp"
        android:textColor="#00FF88"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI-powered exam assistant"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gemini API Key"
        android:textColor="#CCCCCC"
        android:textSize="13sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AIza..."
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:background="#2a2a4a"
        android:padding="14dp"
        android:inputType="textPassword"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dapetin key gratis di: aistudio.google.com"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🚀 AKTIFKAN OVERLAY"
        android:textColor="#000000"
        android:backgroundTint="#00FF88"
        android:textStyle="bold"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Setelah aktif, minimize app ini.\nFloating button akan muncul di layar.\nTap ✂️ → drag area soal → AI jawab!"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"/>

</LinearLayout>
