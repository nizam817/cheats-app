<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ======================= -->
    <!-- MODE 1: CLOCK (SAMARAN) -->
    <!-- ======================= -->
    <LinearLayout
        android:id="@+id/layoutClock"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp"
        android:background="@drawable/clock_bg">

        <!-- Jam besar -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-light"/>

        <!-- Tanggal kecil -->
        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sen, 01 Jan"
            android:textSize="9sp"
            android:textColor="#AAAAAA"/>

        <!-- Dot kecil di bawah — visual hint buat double tap, keliatan innocent -->
        <View
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:background="#44FFFFFF"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- MODE 2: CHEAT (TERSEMBUNYI) -->
    <!-- ========================= -->
    <LinearLayout
        android:id="@+id/layoutCheat"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/overlay_bg">

        <!-- Header: tombol back ke clock + label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:background="#CC1a1a2e"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧠 AI Cheat"
                android:textColor="#00FF88"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <!-- Tombol balik ke clock (samarin lagi) -->
            <Button
                android:id="@+id/btnBack"
                android:layout_width="68dp"
                android:layout_height="26dp"
                android:text="🕐 Hide"
                android:textSize="10sp"
                android:textColor="#CCCCCC"
                android:backgroundTint="#33FFFFFF"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- Area jawaban AI -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <TextView
                android:id="@+id/tvAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textColor="#EEEEEE"
                android:textSize="12sp"
                android:background="#CC0d0d1a"
                android:lineSpacingMultiplier="1.4"/>
        </ScrollView>

        <!-- Tombol crop -->
        <Button
            android:id="@+id/btnCrop"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="✂️  Crop Soal → AI Jawab"
            android:textColor="#000000"
            android:backgroundTint="#00FF88"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="double tap → balik ke jam"
            android:textColor="#444444"
            android:textSize="9sp"
            android:gravity="center"
            android:padding="3dp"/>

    </LinearLayout>

</FrameLayout>
